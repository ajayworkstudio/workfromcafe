# === Supabase (Project Settings → API) ===
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Hanya dipakai di server (webhook Midtrans & cron). JANGAN pernah diekspos ke browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === Midtrans (OPSIONAL, saat ini tidak dipakai — pembayaran lewat QRIS manual) ===
MIDTRANS_SERVER_KEY=Mid-server-xxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=Mid-client-xxxx
# false = sandbox, true = produksi
MIDTRANS_IS_PRODUCTION=false

# === Aplikasi ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Harga paket (Rupiah)
PRICE_MONTHLY=25000
PRICE_YEARLY=250000

# === Opsional: email pengingat H-3 lewat Resend (resend.com) ===
# Email notifikasi (naik level author). Pilih salah satu:
# 1) Gmail: SMTP_USER=emailkamu@gmail.com, SMTP_PASS=16 huruf App Password
SMTP_USER=
SMTP_PASS=
# 2) Resend (butuh domain terverifikasi)
RESEND_API_KEY=
EMAIL_FROM="WFC Hunters <emailkamu@gmail.com>"

# Rahasia untuk endpoint cron (Vercel otomatis mengirim header Authorization: Bearer CRON_SECRET)
CRON_SECRET=ganti-dengan-string-acak

# === Opsional: backup foto Supabase ke Google Drive (cron harian /api/cron/backup-drive) ===
# OAuth akun Google pemilik folder. Ambil refresh token lewat OAuth Playground dengan scope
# https://www.googleapis.com/auth/drive, dan set OAuth consent screen ke "In production"
# (kalau masih "Testing", refresh token kedaluwarsa setelah 7 hari).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# ID folder dari URL drive.google.com/drive/folders/<ID>
GDRIVE_BACKUP_FOLDER_ID=10aMV_9au1B-Gw7oJB4ZTlfKtbRloMyW3
