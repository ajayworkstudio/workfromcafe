# === Supabase (Project Settings → API) ===
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Hanya dipakai di server (webhook Midtrans & cron). JANGAN pernah diekspos ke browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === Midtrans (Dashboard → Settings → Access Keys) ===
MIDTRANS_SERVER_KEY=Mid-server-xxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=Mid-client-xxxx
# false = sandbox, true = produksi
MIDTRANS_IS_PRODUCTION=false

# === Aplikasi ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Ngopi Jateng

# Harga paket (Rupiah)
PRICE_MONTHLY=25000
PRICE_YEARLY=250000

# === Opsional: email pengingat H-3 lewat Resend (resend.com) ===
RESEND_API_KEY=
EMAIL_FROM="Ngopi Jateng <halo@domainkamu.com>"

# Rahasia untuk endpoint cron (Vercel otomatis mengirim header Authorization: Bearer CRON_SECRET)
CRON_SECRET=ganti-dengan-string-acak
